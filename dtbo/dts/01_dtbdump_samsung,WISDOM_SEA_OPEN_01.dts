	fragment@model {
		target-path = "/";

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			model = "Samsung WISDOM SEA OPEN 00 board based on EXYNOS7904";

			fixed-rate-clocks {

				oscclk {
					compatible = "samsung,exynos7885-oscclk";
					clock-frequency = <0x18cba80>;
				};
			};

			firmware {

				android {
					compatible = "android,firmware";

					vbmeta {
						compatible = "android,vbmeta";
						parts = "vbmeta,boot,recovery,system,vendor,product,dtb,dtbo";
					};

					fstab {
						compatible = "android,fstab";

						vendor {
							compatible = "android,vendor";
							dev = "/dev/block/platform/13500000.dwmmc0/by-name/vendor";
							type = "ext4";
							mnt_flags = "ro";
							fsmgr_flags = "wait,verify,avb";
						};

						product {
							compatible = "android,product";
							dev = "/dev/block/platform/13500000.dwmmc0/by-name/product";
							type = "ext4";
							mnt_flags = "ro";
							fsmgr_flags = "wait,verify,avb";
						};
					};
				};
			};

			but_zones {
				#list-but-cells = <0x03>;
				linux,phandle = <0x06>;
				phandle = <0x06>;
			};

			secgpio_dvs {
				compatible = "samsung,exynos7885-secgpio-dvs";
				status = "okay";
			};

			speedy@11CE0000 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";

				cod3035x@03 {
					compatible = "codec,cod3035x";
					#sound-dai-cells = <0x01>;
					reg = <0x03>;
					i2c-speedy-address;
					vdd-supply = <0x05>;
					pinctrl-names = "default";
					mic-bias1-voltage = <0x01>;
					mic-bias2-voltage = <0x01>;
					mic-bias-ldo-voltage = <0x03>;
					use-lassenA;
					use-btn-adc-mode;
					dis-ovp-det-mode;
					use-det-gdet-adc-mode = <0x01>;
					jackout-dbnc-time = <0x05>;
					jack-imp-tuning = <0x09>;
					io-channels = <0xffffffff 0x03 0xffffffff 0x07>;
					io-channel-names = "adc-ear\0adc-gdet";
					#io-channel-cells = <0x01>;
					rcv-drv-current = <0x01>;
					io-channel-ranges;
					but-zones-list = <0x06 0xe2 0x00 0x178 0x06 0x246 0x179 0x1bf 0x06 0x73 0x1c0 0x273 0x06 0x72 0x274 0x489>;
					mic-adc-range = <0x57c>;
					btn-release-value = <0x57c>;
					linux,phandle = <0x09>;
					phandle = <0x09>;
				};

				s2mpu08mfd@00 {
					compatible = "samsung,s2mpu08mfd";
					acpm-ipc-channel = <0x02>;
					i2c-speedy-address;
					s2mpu08,wakeup = "enabled";
					s2mpu08,irq-gpio = <0xffffffff 0x00 0x00>;
					reg = <0x00>;
					interrupts = <0x02 0x00 0x00>;
					interrupt-parent = <0xffffffff>;
					pinctrl-names = "default";
					pinctrl-0 = <0x07 0x08>;
					wtsr_en = "enabled";
					smpl_en = "enabled";
					wtsr_timer_val = <0x03>;
					smpl_timer_val = <0x00>;
					check_jigon = <0x00>;
					init_time,sec = <0x00>;
					init_time,min = <0x00>;
					init_time,hour = <0x0c>;
					init_time,mday = <0x01>;
					init_time,mon = <0x00>;
					init_time,year = <0x77>;
					init_time,wday = <0x02>;
					samsung,codec-interrupt = <0x09>;

					regulators {

						BUCK1 {
							regulator-name = "vdd_mif";
							regulator-min-microvolt = <0x7a120>;
							regulator-max-microvolt = <0x10c8e0>;
							regulator-always-on;
							regulator-ramp-delay = <0x2ee0>;
