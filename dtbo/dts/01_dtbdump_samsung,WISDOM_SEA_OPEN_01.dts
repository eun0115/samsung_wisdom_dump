	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;

			modem_if {
				compatible = "exynos,modem_if";
				reg = <0x00 0xf5400000 0x7800000>;
			};

			cp_ram_logging {
				compatible = "exynos,cp_ram_logging";
				reg = <0x00 0xfcc00000 0x2000000>;
			};
		};
	};

	fragment@battery {
		target-path = "/";

